# Binary files
*.a binary
*.png binary
*.icns binary
*.wav binary

# Swift module files
*.swiftmodule binary
*.swiftdoc binary
*.swiftsourceinfo binary

# Large binaries - mark for tracking awareness
fluidaudio-libs/** binary

# --- Append-only analytics taxonomy (union merge) ---
# The PostHog event registry is line-oriented: each event/property entry is a
# self-contained line. Union merge is safe there, and the normalizer below
# re-sorts/dedupes after a merge. Do not use union merge on brace-balanced
# Swift test/code blocks.
*.psv merge=union
docs/privacy-first-observability.md merge=union
docs/posthog-product-learning-plan.md merge=union
docs/install-attribution-map.md merge=union
docs/activation-lane.md merge=union
