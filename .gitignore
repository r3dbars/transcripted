# Build artifacts
build/
.build/

# Retired FluidAudio pre-build artifacts. Nothing regenerates these anymore
# (build-fluidaudio.sh is gone; build-deps.sh owns dependency builds now), but the
# rules stay as guardrails: committed copies of these are what put ~200MB of dead
# binaries permanently into this repo's history. Cheap to keep, expensive to undo.
.fluidaudio-build/
fluidaudio-libs/
fluidaudio-modules/

# Unified dependency build artifacts (regenerated by build-deps.sh)
.deps-build/
deps-libs/
deps-modules/
deps-frameworks/
deps-tools/
# Same four paths without the trailing slash. A `foo/` pattern only matches a
# directory, so when one of these is a symlink into a worktree instead of a real
# build output it slips past the rules above and gets committed (that happened
# in bf42a73f, shipping four absolute self-referential symlinks to main).
deps-libs
deps-modules
deps-frameworks
deps-tools

# Test scratch files
test-model.swift
.autoeval/

